{
  "uid": "am-health",
  "title": "am \u2014 Errors & performance",
  "description": "Anonymous usage reports from am (TELEMETRY.md): where errors and crashes happen, and stage timings against perf::BUDGETS.",
  "tags": [
    "am",
    "usage-reports"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "timezone": "utc",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "regex": "/^(?!.*(alert-state-history|usage-insights)).*$/"
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "service_version",
          "stream": "{service_name=\"am\"}",
          "type": 1
        },
        "definition": "label_values({service_name=\"am\"}, service_version)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {},
        "refresh": 2,
        "sort": 4
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Errors and crashes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Installs hitting an error (24 h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (am_install_id) (count_over_time({service_name=\"am\"} | event_name=\"am.error\" | service_version=~\"$version\" [24h])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "title": "Crashes (range)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"am\"} | event_name=\"am.crash\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Errors and warnings by version",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (service_version, detected_level) (count_over_time({service_name=\"am\"} | event_name=\"am.error\" | service_version=~\"$version\" [$__interval]))",
          "legendFormat": "{{service_version}} {{detected_level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Where errors happen (count and installs affected)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (level, module, code_filepath, code_lineno, error_kind) (count_over_time({service_name=\"am\"} | event_name=\"am.error\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count by (level, module, code_filepath, code_lineno, error_kind) (sum by (level, module, code_filepath, code_lineno, error_kind, am_install_id) (count_over_time({service_name=\"am\"} | event_name=\"am.error\" | service_version=~\"$version\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "events",
              "Value #B": "installs"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "installs",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "code_filepath:code_lineno is the WARN/ERROR call in am's source; the message itself is never sent."
    },
    {
      "id": 6,
      "title": "Crashes by location and version",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (service_version, am_binary, code_filepath, code_lineno) (count_over_time({service_name=\"am\"} | event_name=\"am.crash\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "crashes"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Performance",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "Stage p95 across installs (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | unwrap p95_us [$__interval]) by (stage) / 1000",
          "legendFormat": "{{stage}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "description": "The 95th percentile, across installs, of each install's 5-minute p95. Budgets (perf::BUDGETS): ui.frame 16ms, ui.input 50ms, collector.cycle 500ms, collector.sync 300ms, collector.git 3000ms, collector.context 100ms, collector.procscan 50ms, collector.usage 100ms, collector.stacks 1000ms, integrations.github 10000ms, integrations.linear 10000ms, integrations.reviews 10000ms"
    },
    {
      "id": 9,
      "title": "Stages over budget (share of 5-minute reports)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"ui.frame\" | p95_us > 16000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"ui.frame\" [$__range]))",
          "legendFormat": "ui.frame",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"ui.input\" | p95_us > 50000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"ui.input\" [$__range]))",
          "legendFormat": "ui.input",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.cycle\" | p95_us > 500000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.cycle\" [$__range]))",
          "legendFormat": "collector.cycle",
          "queryType": "instant"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.sync\" | p95_us > 300000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.sync\" [$__range]))",
          "legendFormat": "collector.sync",
          "queryType": "instant"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.git\" | p95_us > 3000000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.git\" [$__range]))",
          "legendFormat": "collector.git",
          "queryType": "instant"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.context\" | p95_us > 100000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.context\" [$__range]))",
          "legendFormat": "collector.context",
          "queryType": "instant"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.procscan\" | p95_us > 50000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.procscan\" [$__range]))",
          "legendFormat": "collector.procscan",
          "queryType": "instant"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.usage\" | p95_us > 100000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.usage\" [$__range]))",
          "legendFormat": "collector.usage",
          "queryType": "instant"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.stacks\" | p95_us > 1000000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"collector.stacks\" [$__range]))",
          "legendFormat": "collector.stacks",
          "queryType": "instant"
        },
        {
          "refId": "J",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"integrations.github\" | p95_us > 10000000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"integrations.github\" [$__range]))",
          "legendFormat": "integrations.github",
          "queryType": "instant"
        },
        {
          "refId": "K",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"integrations.linear\" | p95_us > 10000000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"integrations.linear\" [$__range]))",
          "legendFormat": "integrations.linear",
          "queryType": "instant"
        },
        {
          "refId": "L",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"integrations.reviews\" | p95_us > 10000000 [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.perf\" | service_version=~\"$version\" | stage=\"integrations.reviews\" [$__range]))",
          "legendFormat": "integrations.reviews",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ui.frame"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ui.input"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "collector.cycle"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "collector.sync"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "collector.git"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "F"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "collector.context"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "G"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "collector.procscan"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "H"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "collector.usage"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "I"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "collector.stacks"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "J"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "integrations.github"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "K"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "integrations.linear"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "L"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "integrations.reviews"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    }
  ]
}
