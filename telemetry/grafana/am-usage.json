    },
    {
      "id": 13,
      "title": "Integrations and options on (share of heartbeats)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" | github=\"true\" [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "github",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" | linear=\"true\" [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "linear",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" | reviews=\"true\" [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "reviews",
          "queryType": "instant"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" | compact=\"true\" [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "compact",
          "queryType": "instant"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" | cmux=\"true\" [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "cmux",
          "queryType": "instant"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "(sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" | builtin_theme=\"true\" [$__range])) or vector(0)) / sum(count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__range]))",
          "legendFormat": "builtin_theme",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "github"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "linear"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "reviews"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "compact"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "cmux"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "F"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "builtin_theme"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
