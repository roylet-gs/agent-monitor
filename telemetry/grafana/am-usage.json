      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (am_install_method) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__interval]))",
          "legendFormat": "{{am_install_method}}",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Setup",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Mode",
      "type": "piechart",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
