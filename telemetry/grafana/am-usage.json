      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (terminal) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" | terminal!=\"\" [$__interval]))",
          "legendFormat": "{{terminal}}",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        }
