{
  "uid": "am-usage",
  "title": "am \u2014 Adoption & usage",
  "description": "Anonymous usage reports from am (TELEMETRY.md): installs, versions, setup and features.",
  "tags": [
    "am",
    "usage-reports"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "timezone": "utc",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "regex": "/^(?!.*(alert-state-history|usage-insights)).*$/"
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "service_version",
          "stream": "{service_name=\"am\"}",
          "type": 1
        },
        "definition": "label_values({service_name=\"am\"}, service_version)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {},
        "refresh": 2,
        "sort": 4
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Adoption",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Active installs (last 24 h)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (am_install_id) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [24h])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Installs that sent a daily heartbeat in the last day (distinct random install ids)."
    },
    {
      "id": 3,
      "title": "Active installs (last 7 d)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (am_install_id) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [7d])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active installs (last 30 d)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (am_install_id) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [30d])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active installs (rolling 24 h)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (am_install_id) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [1d])))",
          "legendFormat": "installs",
          "queryType": "range"
        }
      ],
      "description": "Distinct installs with a heartbeat in the 24 hours before each point."
    },
    {
      "id": 6,
      "title": "Versions",
      "type": "piechart",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (service_version) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" [$__interval]))",
          "legendFormat": "{{service_version}}",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 7,
      "title": "OS / CPU",
      "type": "piechart",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 4,
        "y": 5,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (os_type, host_arch) (count_over_time({service_name=\"am\"} | event_name=\"am.heartbeat\" | service_version=~\"$version\" [$__interval]))",
          "legendFormat": "{{os_type}} {{host_arch}}",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 8,
