{
  "name": "agent-monitor-dev",
  "private": true,
  "description": "Dev tooling for the agent-monitor repo (E2E harness). The published npm packages are assembled from npm/ by .github/workflows/publish.yml.",
  "scripts": {
    "test:e2e": "docker compose -f e2e/docker-compose.yml up --build --force-recreate --abort-on-container-exit --exit-code-from tests",
    "test:e2e:build": "docker compose -f e2e/docker-compose.yml build",
    "test:e2e:clean": "docker compose -f e2e/docker-compose.yml down -v --rmi local"
  },
  "devDependencies": {
    "@playwright/test": "1.50.0",
    "tsx": "^4.19.2"
  }
}
