{
  "id": "hermes",
  "name": "Hermes Agent",
  "shortName": "Hermes",
  "program": "hermes",
  "configDir": "~/.hermes",
  "hooks": {
    "settingsPath": "~/.hermes/config.yaml",
    "timeoutMs": 5000,
    "timeoutUnit": "s"
  },
  "events": {
    "on_session_start": "SessionStart",
    "on_session_reset": "SessionStart",
    "pre_llm_call": "UserPromptSubmit",
    "pre_tool_call": "PreToolUse",
    "post_tool_call": "PostToolUse",
    "on_human_input_request": "PermissionRequest",
    "on_human_input_resolved": "PostToolUse",
    "on_session_end": "Stop",
    "on_session_finalize": "SessionEnd"
  },
  "tools": {
    "terminal": "Bash", "read_file": "Read", "write_file": "Write", "patch": "Edit",
    "clarify": "AskUserQuestion"
  },
  "resume": { "session": ["--resume", "{id}"], "continue": ["--continue"] },
  "process": { "names": ["hermes"] },
  "notes": "Waiting needs Hermes from 2026-10-05 on (its on_human_input_* hooks). Installing also approves am's hook commands in shell-hooks-allowlist.json, for the gateway and cron too (am ignores their turns)"
}
