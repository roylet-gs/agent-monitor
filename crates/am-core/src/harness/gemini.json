{
  "id": "gemini",
  "name": "Gemini CLI",
  "shortName": "Gemini",
  "program": "gemini",
  "configDir": "~/.gemini",
  "hooks": {
    "settingsPath": "~/.gemini/settings.json",
    "projectDirVar": "GEMINI_PROJECT_DIR",
    "matcher": "*",
    "timeoutMs": 5000,
    "name": "agent-monitor"
  },
  "events": {
    "SessionStart": "SessionStart",
    "SessionEnd": "SessionEnd",
    "BeforeAgent": "UserPromptSubmit",
    "AfterAgent": "Stop",
    "BeforeTool": "PreToolUse",
    "AfterTool": "PostToolUse",
    "Notification": "Notification"
  },
  "tools": {
    "run_shell_command": "Bash",
    "read_file": "Read",
    "write_file": "Write",
    "replace": "Edit",
    "glob": "Glob",
    "grep_search": "Grep",
    "web_fetch": "WebFetch",
    "google_web_search": "WebSearch",
    "ask_user": "AskUserQuestion",
    "enter_plan_mode": "EnterPlanMode",
    "exit_plan_mode": "ExitPlanMode",
    "invoke_agent": "Agent"
  },
  "fields": { "last_assistant_message": "prompt_response" },
  "notificationTypes": { "ToolPermission": "permission_prompt" },
  "resume": { "session": ["--resume", "{id}"], "continue": ["--resume", "latest"] },
  "process": { "names": ["gemini", "gemini.js"], "argvContains": ["/@google/gemini-cli/"] },
  "notes": "Gemini runs hooks only in trusted folders"
}
