{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "am harness plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "program", "hooks", "events"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
    "name": { "type": "string", "minLength": 1 },
    "shortName": { "type": "string" },
    "program": { "type": "string", "pattern": "^\\S+$" },
    "configDir": { "type": "string" },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settingsPath", "projectDirVar"],
      "properties": {
        "settingsPath": { "type": "string" },
        "projectDirVar": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "matcher": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" }
      }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9_.:-]+$" },
      "additionalProperties": {
        "enum": ["SessionStart", "SessionEnd", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Stop", "StopFailure", "Notification", "PermissionRequest", "SubagentStart", "SubagentStop"]
      }
    },
    "tools": { "type": "object", "additionalProperties": { "type": "string" } },
    "fields": { "type": "object", "additionalProperties": { "type": "string" } },
    "notificationTypes": { "type": "object", "additionalProperties": { "type": "string" } },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": { "type": "array", "items": { "type": "string" } },
        "continue": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": { "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "names": { "type": "array", "items": { "type": "string" } },
        "argvContains": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "string" },
    "status": { "enum": ["draft", "published"] },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captureEvents": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" } },
        "promptArgs": { "type": "array", "items": { "type": "string" } },
        "verifiedWith": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
